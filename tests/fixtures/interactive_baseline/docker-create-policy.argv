docker
    container
    inspect
    -f
    {{index .Config.Labels "llm-in-a-box.runtime"}}|{{.Config.Image}}|{{.State.Status}}
    s1

docker
    inspect
    -f
    {{.State.Status}}
    s1

docker
    image
    inspect
    llm-in-a-box:docker

docker
    network
    create
    --internal
    llm-in-a-box-net-s1

docker
    network
    create
    llm-in-a-box-relaynet-s1

docker
    run
    -d
    --name
    llm-in-a-box-relay-s1
    --user
    <UID>:<GID>
    -e
    LLMBOX_POLICY=/policy.json
    -e
    LLMBOX_DENY_LOG=/log/deny.log
    -v
    <FIXTURE>/policy.json:/policy.json:ro
    -v
    <FIXTURE>/state/netlogs/s1:/log
    --network
    llm-in-a-box-net-s1
    --network
    llm-in-a-box-relaynet-s1
    llm-in-a-box-relay:latest

docker
    image
    inspect
    --format
    {{.Config.User}}
    llm-in-a-box:docker

docker
    run
    -d
    --privileged
    --name
    s1
    --hostname
    s1
    --label
    llm-in-a-box.runtime=docker
    --label
    llm-in-a-box.user=agent
    -e
    HOST_USER=<USER>
    -e
    HOST_UID=<UID>
    -e
    HOST_GID=<GID>
    -e
    HTTP_PROXY=http://llm-in-a-box-relay-s1:3128
    -e
    HTTPS_PROXY=http://llm-in-a-box-relay-s1:3128
    -e
    http_proxy=http://llm-in-a-box-relay-s1:3128
    -e
    https_proxy=http://llm-in-a-box-relay-s1:3128
    -e
    NO_PROXY=localhost,127.0.0.1
    -e
    no_proxy=localhost,127.0.0.1
    -e
    JAVA_TOOL_OPTIONS=-Dhttp.proxyHost=llm-in-a-box-relay-s1 -Dhttp.proxyPort=3128 -Dhttps.proxyHost=llm-in-a-box-relay-s1 -Dhttps.proxyPort=3128 -Dhttp.nonProxyHosts=localhost|127.0.0.1
    --network
    llm-in-a-box-net-s1
    --label
    llm-in-a-box.net-policy=<FIXTURE>/policy.json
    -v
    <FIXTURE>/cwd:/data
    -v
    s1-docker:/var/lib/docker
    llm-in-a-box:docker

docker
    inspect
    -f
    {{.State.Status}}
    s1

docker
    exec
    s1
    test
    -f
    /tmp/.user-ready

docker
    exec
    s1
    id
    <USER>

docker
    exec
    -it
    -e
    HOME=/home/agent
    -w
    /data
    s1
    gosu
    <USER>
    bash
